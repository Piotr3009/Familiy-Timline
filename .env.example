# ── Supabase ──────────────────────────────────────────────────────────
# Project URL and keys: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER exposed to the browser. Used for
# narrow admin operations (resolving claimer emails, seeding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────
# Public base URL of the deployment (no trailing slash). Used in invite
# links, OAuth redirects and emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (transactional email) ──────────────────────────────────────
# API key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sender, e.g. "Family Timeline <hello@yourdomain.com>"
EMAIL_FROM="Family Timeline <hello@yourdomain.com>"

# ── Google OAuth (configured in Supabase dashboard; local dev only) ───
# Auth -> Providers -> Google in the Supabase dashboard for production.
# These are read by supabase/config.toml for `supabase start`.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=your-google-client-secret
